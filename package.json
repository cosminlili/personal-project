{
  "name": "personal-project",
  "version": "1.0.0",
  "description": "NestJS monorepo with gateway and authentication microservice",
  "private": true,
  "scripts": {
    "start": "nest start",
    "start:dev:gateway": "nest start gateway --watch",
    "start:dev:authentication": "nest start authentication --watch",
    "build": "nest build",
    "test": "jest",
    "test:auth": "jest --config apps/authentication/test/jest.config.js",
    "test:gateway": "jest --config apps/gateway/test/jest.config.js"
  },
  "dependencies": {
    "@nestjs/cache-manager": "^2.1.1",
    "@nestjs/common": "^10.3.3",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.3.3",
    "@nestjs/microservices": "^10.3.3",
    "@nestjs/mongoose": "^10.0.2",
    "@nestjs/platform-express": "^10.3.3",
    "@nestjs/swagger": "^7.3.1",
    "bcrypt": "^5.1.1",
    "cache-manager": "^5.4.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "joi": "^17.12.3",
    "mongoose": "^8.1.2",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.2",
    "@nestjs/schematics": "^10.1.1",
    "@nestjs/testing": "^10.3.3",
    "@types/bcrypt": "^5.0.2",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.11.16",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "supertest": "^6.3.4",
    "@types/supertest": "^2.0.16"
  }
}
